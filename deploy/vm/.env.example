# ── Infrastructure ────────────────────────────────────────────────────────────
DB_PASSWORD=change_me_strong_password

# ── Stack Overflow / StackExchange API ────────────────────────────────────────
# Get a key at https://stackapps.com/apps/oauth/register
# Without a key the app still works but is limited to 300 requests/day.
STACKEXCHANGE_API_KEY=your_stackexchange_api_key

# ── Mistral AI ────────────────────────────────────────────────────────────────
# Required for Phase 2 (embeddings) and Phase 3 (AI Overview).
# Get a key at https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key

# ── Jina AI ───────────────────────────────────────────────────────────────────
# Used as a fallback search provider when the StackExchange quota is exhausted.
# Get a key at https://jina.ai/
JINA_API_KEY=your_jina_api_key

# ── Feature flags ─────────────────────────────────────────────────────────────
EMBEDDING_ENABLED=true
EMBEDDING_PROVIDER=mistral
EMBEDDING_MODEL=mistral-embed
LLM_ENABLED=true
LLM_MODEL=mistral-small-latest
