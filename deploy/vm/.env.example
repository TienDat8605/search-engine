# ── Infrastructure ────────────────────────────────────────────────────────────
DB_PASSWORD=change_me_strong_password

# ── Stack Overflow / StackExchange API ────────────────────────────────────────
# Get a key at https://stackapps.com/apps/oauth/register
# Without a key the app still works but is limited to 300 requests/day.
STACKEXCHANGE_API_KEY=your_stackexchange_api_key

# ── Mistral AI ────────────────────────────────────────────────────────────────
# Required for Phase 2 (embeddings) and Phase 3 (AI Overview).
# Get a key at https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key

# ── Jina AI ───────────────────────────────────────────────────────────────────
# Used as a fallback search provider when the StackExchange quota is exhausted.
# Get a key at https://jina.ai/
JINA_API_KEY=your_jina_api_key

# ── Feature flags ─────────────────────────────────────────────────────────────
# Phase 2: set to true to enable Mistral embedding backfill (mistral-embed).
# The scheduler runs every 5 min and embeds documents with NULL embedding.
EMBEDDING_ENABLED=true

# Phase 3: set to true to enable the AI Overview panel (mistral-small-latest).
# Requires MISTRAL_API_KEY. Safe to keep false until embeddings are populated.
LLM_ENABLED=true
